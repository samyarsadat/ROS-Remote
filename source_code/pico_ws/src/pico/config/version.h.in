#pragma once

// Standard version macros
#define FIRMWARE_VERSION_MAJOR   @PROJECT_VERSION_MAJOR@
#define FIRMWARE_VERSION_MINOR   @PROJECT_VERSION_MINOR@
#define FIRMWARE_VERSION_PATCH   @PROJECT_VERSION_PATCH@
#define FIRMWARE_VERSION_STRING  "@PROJECT_VERSION@"

// Version with full build timestamp
#define FIRMWARE_VERSION_FULL_STRING  "@PROJECT_VERSION@-@BUILD_TS@"

// USB BDC version macro
static_assert(FIRMWARE_VERSION_MAJOR < 100, "major must be 0..99");
static_assert(FIRMWARE_VERSION_MINOR < 100, "minor must be 0..99");

#include <stdint.h>
#define USB_BCD16(maj, min) (uint16_t)( \
    (((maj) / 10) << 12) | (((maj) % 10) << 8) | \
    (((min) / 10) <<  4) |  ((min) % 10) )

#define USB_DEVICE_BCD  USB_BCD16(FIRMWARE_VERSION_MAJOR, FIRMWARE_VERSION_MINOR)
